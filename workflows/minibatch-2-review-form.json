      "id": "9429dd6e-eeed-5a65-ac13-eb3b9dd58707",
      "name": "승인·반려 요청",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        -120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "mbJobApi0000001",
          "name": "MiniBatch job-api"
        }
      },
      "notes": "POST /jobs/{id}/approve 또는 reject",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// 요청 목록과 응답을 차례로 맞춘다\nconst req = $('처리 목록').all().map(i => i.json);\nconst res = $input.all().map(i => i.json);\nconst lines = req.map((r, i) => {\n  const x = res[i] || {};\n  const ok = x.statusCode === 200;\n  const pub = x.body?.publish;\n  const tail = ok ? (r.path === 'approve' ? (pub?.ok ? `→ ${pub.status}` : `승인됨, 공개 실패: ${pub?.error || pub?.skipped || ''}`) : '→ 반려')\n                  : `실패: ${x.body?.error?.message || x.statusCode}`;\n  return `${r.jobId} ${r.path === 'approve' ? '승인' : '반려'} ${tail}`;\n});\nreturn [{ json: { message: lines.join('\\n') } }];"
      },
