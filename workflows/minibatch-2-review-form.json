      "id": "d14e7217-00ad-5c73-99c2-90aaa9ead270",
      "name": "작업 상세",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "mbJobApi0000001",
          "name": "MiniBatch job-api"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 시리즈·화 순서대로 보여 준다. 화마다 영상 링크와 승인/반려/보류, 반려 사유\nconst esc = s => String(s ?? '').replace(/[<>&\"]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '\"': '&quot;' }[c]));\nconst jobs = $input.all().map(i => i.json).filter(j => j && j.id && j.status === 'REVIEW');\njobs.sort((a, b) => (a.seriesId || '~').localeCompare(b.seriesId || '~') || (a.episodeNumber || 0) - (b.episodeNumber || 0)\n                    || a.createdAt.localeCompare(b.createdAt));\nif (!jobs.length) return [{ json: { empty: true, fields: [] } }];\nconst fields = [];\nfor (const j of jobs) {\n  const vid = j.publication?.videoId;\n  const head = j.seriesId ? `${esc(j.seriesId)} ${j.episodeNumber}화` : '단독 주제';\n  const links = vid ? `<a href=\"https://www.youtube.com/shorts/${vid}\" target=\"_blank\">영상 보기(비공개)</a> · <a href=\"https://studio.youtube.com/video/${vid}/edit\" target=\"_blank\">Studio</a>` : '영상 없음';\n  fields.push({ fieldType: 'html', fieldName: `h_${j.id}`, html: `<h3>${head}: ${esc(j.topic)}</h3><p>${links} · ${esc(j.id)}</p>` });\n  fields.push({ fieldType: 'dropdown', fieldName: j.id, fieldLabel: `${head} 결정`,\n                fieldOptions: { values: [{ option: '보류' }, { option: '승인' }, { option: '반려' }] }, requiredField: true });\n  fields.push({ fieldType: 'text', fieldName: `${j.id}__reason`, fieldLabel: '반려 사유 (반려일 때)' });\n}\nreturn [{ json: { empty: false, fields, order: jobs.map(j => j.id) } }];"
      },
      "id": "1b2884b7-909c-5ea7-9e75-d32a201285bd",
      "name": "폼 만들기",
