        "completionTitle": "검토 대기 영상이 없습니다",
        "completionMessage": "새 영상이 만들어지면 텔레그램으로 알립니다.",
        "options": {}
      },
      "id": "187a1090-41a8-5e27-9e20-937ff294ef03",
      "name": "끝: 검토 대기 없음",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        1540,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// 폼에서 고른 것을 화 순서대로 요청 목록으로 만든다 (보류는 빼고)\nconst by = $('검토 화면').first().json;\nconst who = $('영상 검토 폼').first().json['승인자'] || '운영자';\nconst out = [];\nfor (const id of $('폼 만들기').first().json.order) {\n  const d = by[id];\n  if (d === '승인') out.push({ json: { jobId: id, path: 'approve', body: { approvedBy: who } } });\n  if (d === '반려') out.push({ json: { jobId: id, path: 'reject', body: { rejectedBy: who, reason: by[`${id}__reason`] || '사유 없음' } } });\n}\nreturn out.length ? out : [{ json: { jobId: null } }];"
      },
