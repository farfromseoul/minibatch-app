    {
      "parameters": {
        "jsCode": "const items = $input.first().json.items || [];\nreturn items.length ? items.map(j => ({ json: { id: j.id } })) : [{ json: { id: null } }];"
      },
      "id": "e4bb38fb-6b0e-5e99-940c-09be06a3fa99",
      "name": "작업 하나씩",
