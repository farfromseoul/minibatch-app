    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('설정').first().json.api }}/series",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": false
            }
