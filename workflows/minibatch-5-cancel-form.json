      },
      "id": "2c34bf45-2de5-54f5-8dcb-f69991963a86",
      "name": "시리즈 목록",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "mbJobApi0000001",
          "name": "MiniBatch job-api"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 공개 전 작업(D29 취소 가능 상태)과 끝나지 않은 시리즈를 보여 준다\nconst esc = s => String(s ?? '').replace(/[<>&\"]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '\"': '&quot;' }[c]));\nconst JOB_OK = ['PENDING', 'RUNNING', 'WAITING', 'FAILED', 'REVIEW', 'REJECTED'];\nconst SERIES_OK = ['PROPOSED', 'APPROVED', 'ACTIVE', 'PAUSED'];\nconst jobs = ($('작업 목록').first().json.items || []).filter(j => JOB_OK.includes(j.status));\nconst series = ($input.first().json.items || []).filter(s => SERIES_OK.includes(s.status));\nif (!jobs.length && !series.length) return [{ json: { empty: true, fields: [] } }];\nconst fields = [];\nconst opts = { values: [{ option: '유지' }, { option: '취소' }] };\nif (series.length) fields.push({ fieldType: 'html', fieldName: 'h_series', html: '<h3>시리즈</h3><p>시리즈를 취소하면 공개 전 화와 작업도 함께 취소됩니다.</p>' });\nfor (const s of series) {\n  fields.push({ fieldType: 'dropdown', fieldName: `s__${s.id}`, fieldLabel: `${s.title} (${s.status}, 남은 화 ${s.counts?.planned ?? '?'})`, fieldOptions: opts, requiredField: true });\n}\nif (jobs.length) fields.push({ fieldType: 'html', fieldName: 'h_jobs', html: '<h3>작업 (공개 전)</h3><p>시리즈 화를 취소하면 그 시리즈는 멈춤(PAUSED)이 됩니다.</p>' });\nfor (const j of jobs) {\n  const head = j.seriesId ? `${esc(j.seriesId)} ${j.episodeNumber}화` : '단독';\n  fields.push({ fieldType: 'dropdown', fieldName: `j__${j.id}`, fieldLabel: `${head}: ${j.topic} (${j.status}${j.currentStep ? ', ' + j.currentStep : ''})`, fieldOptions: opts, requiredField: true });\n}\nfields.push({ fieldType: 'text', fieldName: 'reason', fieldLabel: '취소 사유', requiredField: true });\nreturn [{ json: { empty: false, fields } }];"
      },
      "id": "8d3040c8-ebe1-5eb4-a9f4-86df79d1bce1",
      "name": "폼 만들기",
