    },
    {
      "parameters": {
        "jsCode": "// 시리즈를 먼저 취소한다 (그 시리즈의 작업은 함께 취소된다). 남은 작업은 하나씩\nconst by = $('취소 화면').first().json;\nconst who = $('취소 폼').first().json['승인자'] || '운영자';\nconst body = { cancelledBy: who, reason: by.reason || '사유 없음' };\nconst out = [];\nfor (const [k, v] of Object.entries(by)) if (k.startsWith('s__') && v === '취소') out.push({ json: { path: `series/${k.slice(3)}/cancel`, label: k.slice(3), body } });\nfor (const [k, v] of Object.entries(by)) if (k.startsWith('j__') && v === '취소') out.push({ json: { path: `jobs/${k.slice(3)}/cancel`, label: k.slice(3), body } });\nreturn out.length ? out : [{ json: { path: null } }];"
      },
      "id": "4a543a21-ca5d-5939-9924-7766a1e4f262",
      "name": "취소 목록",
