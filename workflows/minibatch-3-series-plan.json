      "id": "b1ece345-6027-5bbe-b128-c2c270236b56",
      "name": "계획 상세",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        500
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "mbJobApi0000001",
          "name": "MiniBatch job-api"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/[<>&\"]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '\"': '&quot;' }[c]));\nconst list = $input.all().map(i => i.json).filter(s => s && s.id && s.status === 'PROPOSED');\nif (!list.length) return [{ json: { empty: true, fields: [] } }];\nconst fields = [];\nfor (const s of list) {\n  const chars = (s.bible?.characters || []).map(c => `${esc(c.name)}(${esc(c.role)})`).join(', ');\n  const eps = (s.episodes || []).map(e => `<li><b>${esc(e.title)}</b> — ${esc(e.outline)}</li>`).join('');\n  fields.push({ fieldType: 'html', fieldName: `h_${s.id}`,\n                html: `<h3>${esc(s.title)}</h3><p>${esc(s.bible?.premise)}</p><p>인물: ${chars} · 말투: ${esc(s.bible?.tone)}</p><ol>${eps}</ol>` });\n  fields.push({ fieldType: 'dropdown', fieldName: s.id, fieldLabel: `${s.title} 결정`,\n                fieldOptions: { values: [{ option: '보류' }, { option: '승인' }] }, requiredField: true });\n}\nreturn [{ json: { empty: false, fields, order: list.map(s => s.id) } }];"
      },
      "id": "691d752d-be11-59f7-8d17-044326cb9bfa",
      "name": "계획 폼 만들기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
