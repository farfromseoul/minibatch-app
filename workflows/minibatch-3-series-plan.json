    {
      "parameters": {
        "jsCode": "const by = $('계획 화면').first().json;\nconst who = $('시리즈 계획 승인 폼').first().json['승인자'] || '운영자';\nconst out = $('계획 폼 만들기').first().json.order.filter(id => by[id] === '승인').map(id => ({ json: { id, approvedBy: who } }));\nreturn out.length ? out : [{ json: { id: null } }];"
      },
      "id": "4306e120-3c3c-59bc-ac5b-cbbc5c882195",
      "name": "승인 목록",
