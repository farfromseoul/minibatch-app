    {
      "parameters": {
        "jsCode": "// 설정: 여기 한 곳만 고친다. 텔레그램 chat id 는 비밀 값이 아니다 (봇 토큰은 자격 증명 'MiniBatch 텔레그램' 에)\nreturn [{ json: {\n  api: 'http://job-api:8080',                 // compose 안의 job-api 주소\n  chatId: 'CHAT_ID_를_여기에',                 // 25번 ③에서 확인한 내 chat id (숫자)\n  formBase: 'http://localhost:5678/form',     // 승인 폼 주소 (이 MacBook 브라우저에서 연다)\n  category: 'ai-it',\n} }];"
      },
      "id": "30a16f1f-bdd0-5007-a73d-f4413e422559",
      "name": "설정",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('설정').first().json.api }}/series",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": false
            }
          }
        }
      },
      "id": "4dff4957-8da1-5161-a0df-f790a25b6346",
      "name": "시리즈 목록",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "mbJobApi0000001",
          "name": "MiniBatch job-api"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 승인 대기 계획이 없고, 진행 중 시리즈의 남은 화가 하루치(10)보다 적으면 새 계획 (D27)\nconst items = $input.first().json.items || [];\nif (items.some(s => s.status === 'PROPOSED')) return [];\nconst left = items.filter(s => ['APPROVED', 'ACTIVE'].includes(s.status)).reduce((n, s) => n + (s.counts?.planned || 0), 0);\nreturn left >= 10 ? [] : [{ json: { left } }];"
      },
      "id": "c60b2bb6-9025-5715-a63b-562433e7fd00",
      "name": "계획이 필요한가",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('설정').first().json.api }}/series",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ category: $('설정').first().json.category, episodeCount: 10 }) }}",
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "75e433ed-c6e2-58ad-909a-2facc1785244",
      "name": "계획 만들기 (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "mbJobApi0000001",
          "name": "MiniBatch job-api"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 성공하면 job-api 가 [계획 승인] 버튼 메시지를 보낸다 (D28). 여기서는 실패만 알린다 (busy 는 다음 시각에 다시)\nconst r = $input.first().json;\nif (r.statusCode === 201 || r.body?.error?.code === 'busy') return [];\nreturn [{ json: { text: `⚠️ MiniBatch 시리즈 계획 만들기 실패 (${r.statusCode}): ${r.body?.error?.message || ''}` } }];"
      },
      "id": "82cf71d5-8b14-5fd7-a0df-0280088ecfa4",
      "name": "알림 문장",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('설정').first().json.chatId }}",
        "text": "={{ String($json.text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "6ce739f3-ecec-5e2f-88bd-28b8b97e197d",
      "name": "알림: 계획",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
