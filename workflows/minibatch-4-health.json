      "onError": "continueRegularOutput",
      "notes": "GET /healthz: 서비스·토큰·디스크 점검",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// 같은 경고는 한 번만 보낸다. 사라지면 '회복'. 갱신 토큰 6일째 경고도 여기로 온다 (테스트 상태, 7일 만료)\nconst st = $getWorkflowStaticData('global');\nconst r = $input.first().json;\nlet problems = [];\nif (r.error || !r.status) problems = [`job-api 응답 없음: ${r.error?.message || JSON.stringify(r.error || r).slice(0, 200)}`];\nelse {\n  if (r.status !== 'ok') problems.push(`상태 ${r.status}`);\n  problems = problems.concat(r.warnings || []);\n}\nconst key = problems.join(' | ');\nif (key === (st.last || '')) return [];\nst.last = key;\nreturn [{ json: { text: key ? `⚠️ MiniBatch 상태 경고\\n- ${problems.join('\\n- ')}` : '✅ MiniBatch 상태 회복 (경고 없음)' } }];"
      },
