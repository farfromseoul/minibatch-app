        "jsCode": "// 후보 메시지는 job-api 가 텔레그램으로 보낸다 (D40). 여기서는 실패만 알린다\nconst r = $input.first().json;\nif (r.statusCode === 200) return [];\nreturn [{ json: { text: `⚠️ MiniBatch IT 뉴스 후보 모으기 실패 (${r.statusCode}): ${r.body?.error?.message || ''}\n텔레그램 /news 로 다시 할 수 있습니다` } }];"
